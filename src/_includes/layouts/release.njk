---
layout: layouts/base.njk
---
<article class="entry">
  <a class="back-link" href="/"><span aria-hidden="true">←</span> All updates</a>
  <header class="entry-header">
    <div class="release-meta">
      <span class="badge badge-{{ category }}">{{ category | categoryLabel }}</span>
      <time class="release-date" datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
    </div>
    <h1 class="entry-title">{{ title }}</h1>
    {% if description %}<p class="entry-description">{{ description }}</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
</article>
